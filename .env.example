# WariMitra AI — voice-first Wari assistance (PROTOTYPE)
#
# OPTIONAL. By default the app talks to Gemini through a secure server function
# (Lovable AI) and no key is needed in the browser.
#
# Set this only if you want the prototype to call the Google Gemini API directly
# from the browser during a local demo.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── EXOTEL PHONE AGENT (server-side only, never in frontend code) ────────────
# Add these as project secrets, not in this file.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_EXOPHONE=
EXOTEL_APP_ID=
